{
  "name": "@ev/api",
  "version": "0.1.0",
  "private": true,
  "description": "E-Vigilance API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-mongo.ts",
    "seed": "tsx scripts/seed.ts",
    "migrate": "nest build && node dist/src/cli/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@ev/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "ffmpeg-static": "5.3.0",
    "helmet": "^8.3.0",
    "jose": "6.2.12",
    "mongoose": "^9.11.2",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
