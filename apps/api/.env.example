# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4100

# MongoDB replica set (transactions are required). `pnpm db:local` starts one
# on this address; or use a MongoDB Atlas development cluster.
MONGODB_URI=mongodb://127.0.0.1:27027/evigilance?replicaSet=ev-local

# Origin of the admin panel, for CORS and cookies.
WEB_ORIGIN=http://localhost:5280

# Signing key for access tokens — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Key that encrypts authenticator secrets at rest — 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Secure cookies need HTTPS; set false only for local http development.
COOKIE_SECURE=false

# Hours a sign-in lasts before signing in again (one shift).
SESSION_HOURS=12

# Number of reverse proxies in front of the API (for client IPs), 0 locally.
TRUST_PROXY=0

# Password for the demo accounts created by `pnpm seed` (local/staging only).
SEED_PASSWORD=

# Evidence storage: "local" (development, files under EVIDENCE_DIR) or "r2"
# (staging/production: a private Cloudflare R2 bucket, served through the API).
EVIDENCE_STORAGE=local
EVIDENCE_DIR=.data/evidence
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=

# Optional: path to an ffmpeg binary instead of the bundled one.
FFMPEG_PATH=

# Mobile-app import (docs/11): seconds between runs, 0 = off.
APP_SYNC_INTERVAL_SECONDS=60
# Where evidence paths without a host live, e.g. https://api.app.example.lk
APP_MEDIA_BASE_URL=
# Hosts evidence may be downloaded from, comma-separated (".r2.dev" allows subdomains).
APP_MEDIA_ALLOWED_HOSTS=
