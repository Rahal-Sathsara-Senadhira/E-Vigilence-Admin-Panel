{
  "name": "e-vigilance",
  "private": true,
  "description": "E-Vigilance — Sri Lanka Police traffic enforcement system",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ev/shared build && pnpm --parallel --filter @ev/shared --filter @ev/api --filter @ev/web --filter @ev/pay dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:local": "pnpm --filter @ev/api db:local",
    "seed": "pnpm --filter @ev/api seed",
    "migrate": "pnpm --filter @ev/api migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
