# Copy to .env and fill in. Never commit .env.

# MongoDB (Atlas). The database name is set separately.
MONGODB_URI=
MONGODB_DB_NAME=evigilance_new

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

PORT=4200
WEB_ORIGIN=http://localhost:5300

# Cloudflare R2 — everything this build writes goes under R2_PREFIX.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PREFIX=new e-vigilence/

# Mobile-app import (docs/11): seconds between runs (0 = off), and where the
# app's evidence files may be downloaded from (comma-separated host names;
# required in production).
APP_IMPORT_INTERVAL_SECONDS=60
# APP_MEDIA_BASE_URL=https://media.example.lk/
APP_MEDIA_ALLOWED_HOSTS=
# The app's MEDIA_SERVICE_KEY, sent as X-Media-Key when downloading its evidence.
# Needed once the app serves media only to signed links (its MEDIA_ACCESS=signed).
# APP_MEDIA_KEY=

# Signs the payment simulator's confirmations (docs/07). 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENTS_SIM_SECRET=

# Password for the demo accounts created by `npm run seed` (12+ characters).
SEED_PASSWORD=
