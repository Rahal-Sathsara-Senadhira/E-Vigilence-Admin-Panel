{
  "name": "e-vigilance-backend",
  "version": "0.1.0",
  "private": true,
  "description": "E-Vigilance backend — Sri Lanka Police traffic enforcement (docs/19)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && prettier --check ."
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.3",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "5.9",
    "vitest": "^4.1.12"
  }
}
