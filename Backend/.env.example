PORT=8081
MONGO_URI=mongodb+srv://<user>:<password>@your-cluster.mongodb.net/evigilence
# In development, any http://localhost:<port> / http://127.0.0.1:<port>
# origin is allowed automatically (see app.js) — Vite bumps to the next free
# port whenever the usual one is taken, so this doesn't need to be kept in
# sync during local dev. Only enforced strictly when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=change_me_to_a_long_random_string
DB_PROVIDER=mongo

# Seed script (Backend/src/db/seed/seedAdminUser.js) — set this for anything
# beyond local dev; falls back to a well-known default otherwise.
SEED_ADMIN_PASSWORD=change_me

# Shared secret the separate citizen-reporting backend sends as the
# X-Ingest-Key header when pushing violations into POST /api/violations/ingest.
INGEST_API_KEY=change_me_to_a_long_random_string

# Evidence upload storage (utils/evidenceStorage.js) — OPTIONAL. Priority
# order: Cloudflare R2, then Cloudinary, then GridFS (stored directly in
# this same MongoDB, zero extra accounts needed) as the always-available
# fallback. Leave a provider's block blank/incomplete and it's skipped —
# nothing needs to change in code when credentials are added, removed, or
# swapped later.

# Cloudflare R2 — bucket stays private; files are proxied through this
# backend (GET /api/evidence/r2/:key) rather than needing a public bucket
# URL or custom domain. R2_ACCESS_KEY/R2_SECRET_KEY/R2_ENDPOINT come from an
# R2 API token in the Cloudflare dashboard; R2_BUCKET_NAME is the bucket's
# own name (shown on its overview page, not part of the API token).
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
