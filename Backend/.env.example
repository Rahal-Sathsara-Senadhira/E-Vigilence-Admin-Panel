PORT=8081
MONGODB_USER=your_mongo_user
MONGODB_PASSWORD=your_mongo_password
MONGO_URI=mongodb+srv://<user>:<password>@your-cluster.mongodb.net/evigilence
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=change_me_to_a_long_random_string
DB_PROVIDER=mongo

# Seed script (Backend/src/db/seed/seedAdminUser.js) — set this for anything
# beyond local dev; falls back to a well-known default otherwise.
SEED_ADMIN_PASSWORD=change_me

# Shared secret the separate citizen-reporting backend sends as the
# X-Ingest-Key header when pushing violations into POST /api/violations/ingest.
INGEST_API_KEY=change_me_to_a_long_random_string

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
